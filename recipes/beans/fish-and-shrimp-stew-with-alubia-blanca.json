   "items": [
    "1 lb halibut, cubed",
    "1 lb shrimp, peeled and deveined"
   ]
  },
  {
   "action": "Off heat, stir in:",
   "items": [
    "1 bunch flat-leaf parsley, roughly chopped"
   ]
  },
  {
