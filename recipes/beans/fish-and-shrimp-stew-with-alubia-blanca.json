    "2 yellow onions, thinly sliced into half moons",
    "2 celery stalks, thinly sliced",
    "Pinch of salt"
   ]
  },
  {
   "action": "Add in, cook 1 min:",
   "items": [
    "2 garlic cloves, peeled and smashed",
    "1 tsp New Mexico red chile powder"
   ]
  },
  {
   "action": "Add in, simmer 30 to 40 min:",
   "items": [
    "1 large can (28 oz) whole peeled tomatoes, crushed by hand"
   ]
  },
  {
   "action": "Add in, bring back to simmer:",
   "items": [
    "2 cups cooked beans",
    "Salt and pepper to taste"
   ]
  },
  {
